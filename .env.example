# ==========================================
# MySQL Database Configuration
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_db

# ==========================================
# SQL Execution Safety & Limits
# ==========================================
SQL_EXECUTION_TIMEOUT=10
SQL_MAX_ROWS=100
SQL_ALLOW_WRITE=false

# ==========================================
# Application Settings (Traditional NLP Only)
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO
