# ==========================================
# MySQL Database Configuration
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_db

# ==========================================
# SQL Execution Safety & Limits
# ==========================================
SQL_EXECUTION_TIMEOUT=10
SQL_MAX_ROWS=100
SQL_ALLOW_WRITE=false

# ==========================================
# LLM Provider Configuration
# Supported providers: gemini, openai, offline
# ==========================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# Application Settings
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO

